<?xml version="1.0" encoding="utf-8"?>
<!--
  允许明文 HTTP：
  1. 数据端口 5984 用 HTTP（局域网 CouchDB 兼容协议）；
  2. WebView 加载管理页 /_admin/ 也是 HTTP；
  3. 管理页 JS fetch 控制端口 5985 也是 HTTP。
  Android 9+ 默认禁止明文 HTTP，需显式放行。usesCleartextTraffic=true 已在
  manifest 设置，这里再用 network_security_config 兜底，确保 WebView 也放行。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
